{
  // Builds `src/` into this package: src/runtime/host.mts becomes
  // runtime/host.mjs and runtime/host.d.mts. Run through scripts/build.mjs.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "stripInternal": true,
    "newLine": "lf",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    // Only syntax that disappears when types are removed: the engine strips
    // the orchestrator's types itself and must end up with the same program.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // Named, because the default leaves out the output directory, which here
  // is the package itself.
  "exclude": ["node_modules"]
}
