{
  "name": "{name}",
  "version": "0.1.0",
  "description": "{description}",
  "packageManager": "{package_manager}",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "validate": "codemod workflow validate -w src/workflow.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "codemod": "^{cli_version}"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.18"
  }
}
