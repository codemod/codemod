{
  "protocolVersion": 2,
  "commandId": "rename-api",
  "operation": {
    "kind": "jssg",
    "script": "scripts/rename-api.ts",
    "language": "typescript",
    "include": ["**/*.ts"],
    "exclude": ["**/*.d.ts"],
    "target": {
      "root": "apps/web",
      "include": ["src/**"],
      "exclude": ["**/generated/**"]
    }
  }
}
