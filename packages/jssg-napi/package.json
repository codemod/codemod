{
  "name": "@codemod.com/jssg-napi",
  "version": "0.0.0",
  "private": true,
  "description": "Node addon (napi-rs, crates/jssg-napi) exposing the JSSG SgRoot/SgNode API and the in-process transform engine used by the orchestration 'node' runtime",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ast-grep": {
      "types": "./ast-grep.d.ts",
      "default": "./ast-grep.js"
    },
    "./loader": {
      "types": "./loader.d.ts",
      "default": "./loader.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:debug": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
