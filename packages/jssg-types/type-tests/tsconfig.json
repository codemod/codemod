{
  "extends": "@codemod.com/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "lib": ["ESNext"],
    "types": [],
    // Check the module declarations themselves, not only their use. The vendored
    // LLRT globals are left out: they are written against Node and DOM types.
    "skipLibCheck": false
  },
  "include": [
    "../src/modules/ast-grep.d.ts",
    "../src/modules/langs.d.ts",
    "../src/modules/workflow.d.ts",
    "./*.ts"
  ]
}
