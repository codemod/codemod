From fadd464f0cf4576891ff04b7d359dfe3f06d9392 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 9 Nov 2026 23:22:59 +0000
Subject: [PATCH 17/18] orchestration-build: run for-await bodies that are not
 blocks

oxc 0.96 lowers `for await (x of xs) body;` to a loop that drops `body`
unless it is a block, so a workflow's unbraced for-await loop never ran.
Every for-await gets a block body before lowering.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/orchestration-build/src/bundle.rs | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/crates/orchestration-build/src/bundle.rs b/crates/orchestration-build/src/bundle.rs
index c74b84c8..5750214b 100644
--- a/crates/orchestration-build/src/bundle.rs
+++ b/crates/orchestration-build/src/bundle.rs
@@ -16,11 +16,16 @@ use std::{
 
 use arcstr::ArcStr;
 use oxc::{
-    allocator::Allocator,
+    allocator::{Allocator, TakeIn},
+    ast::{
+        ast::{ForOfStatement, Statement},
+        AstBuilder,
+    },
+    ast_visit::{walk_mut, VisitMut},
     codegen::Codegen,
     parser::Parser,
     semantic::SemanticBuilder,
-    span::SourceType,
+    span::{GetSpan, SourceType},
     transformer::{HelperLoaderMode, TransformOptions, Transformer},
 };
 use rolldown::{Bundler, BundlerOptions, InputItem, OutputFormat, Platform, ResolveOptions};
@@ -405,6 +410,7 @@ fn lower_async(code: &str, id: &str, module_type: &ModuleType) -> Result<String,
         return Err(error.message.to_string());
     }
     let mut program = parsed.program;
+    BlockForAwaitBodies(AstBuilder::new(&allocator)).visit_program(&mut program);
     let scoping = SemanticBuilder::new()
         .build(&program)
         .semantic
@@ -421,6 +427,20 @@ fn lower_async(code: &str, id: &str, module_type: &ModuleType) -> Result<String,
     Ok(Codegen::new().build(&program).code)
 }
 
+/// oxc 0.96 lowers `for await (x of xs) body;` to a loop that never runs
+/// `body` unless it is a block, so every `for await` gets one first.
+struct BlockForAwaitBodies<'a>(AstBuilder<'a>);
+
+impl<'a> VisitMut<'a> for BlockForAwaitBodies<'a> {
+    fn visit_for_of_statement(&mut self, it: &mut ForOfStatement<'a>) {
+        if it.r#await && !matches!(it.body, Statement::BlockStatement(_)) {
+            let body = it.body.take_in(self.0);
+            it.body = self.0.statement_block(body.span(), self.0.vec1(body));
+        }
+        walk_mut::walk_for_of_statement(self, it);
+    }
+}
+
 /// A module id that names a file (not a virtual module such as rolldown's
 /// runtime or an oxc helper).
 fn source_file(id: &str) -> Option<PathBuf> {
