-impl SgRoot {
-    #[napi(constructor)]
-    pub fn new(env: Env) -> Result<Self> {
-        Err(type_error(
-            &env,
-            "'SgRoot' is not constructible. Use 'parse(lang, src)'.",
-        ))
-    }
-
