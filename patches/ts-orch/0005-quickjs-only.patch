-  close(): Promise<void>;
-}
-
-export const DASHBOARD_HOST = "127.0.0.1";
-
-/** Bytes a stream client may leave unread before it is dropped to reconnect. */
-const MAX_CLIENT_BACKLOG = 1024 * 1024;
