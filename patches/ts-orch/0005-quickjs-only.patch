-    fn resolve(&mut self, env: Env, output: Self::Output) -> Result<Self::JsValue> {
-        Ok(output
-            .into_iter()
-            .zip(&self.contents)
-            .map(|(root, content)| root.map(|root| SgRoot::tracked(&env, root, content.len())))
-            .collect())
-    }
