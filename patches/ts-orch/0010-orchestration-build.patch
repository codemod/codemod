@@ -0,0 +1,523 @@
+//! rolldown bundles: one per `jssg()` transform artifact, and the QuickJS
+//! bundle of the whole workflow graph.
+//!
+//! The workflow bundle resolves `@codemod.com/orchestration` (and
+//! `/portable`) to the portable runtime and rejects every other entry point
+//! of the package and every `node:*` import. `codemod:*` stays external: the
+//! host provides it. Async functions and generators are lowered to
+//! generators, so continuations go through `Promise.prototype.then`, which
+//! carries the orchestration async context in QuickJS.
+use std::{
+    borrow::Cow,
+    collections::{BTreeMap, BTreeSet},
+    path::{Component, Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+use arcstr::ArcStr;
+use oxc::{
+    allocator::Allocator,
+    codegen::Codegen,
+    parser::Parser,
+    semantic::SemanticBuilder,
+    span::SourceType,
+    transformer::{HelperLoaderMode, TransformOptions, Transformer},
+};
+use rolldown::{Bundler, BundlerOptions, InputItem, OutputFormat, Platform, ResolveOptions};
+use rolldown_common::{ModuleType, Output, ResolvedExternal};
+use rolldown_plugin::{
+    __inner::SharedPluginable, HookLoadArgs, HookLoadOutput, HookLoadReturn, HookResolveIdArgs,
+    HookResolveIdOutput, HookResolveIdReturn, HookTransformArgs, HookTransformOutput,
+    HookTransformReturn, HookUsage, Plugin, PluginContext, SharedTransformPluginContext,
+};
+
+use crate::{
+    sha256,
+    split::{build_module, JssgArtifact},
+    BuildError,
+};
+
+const PACKAGE: &str = "@codemod.com/orchestration";
+const ARTIFACTS: &str = "__CODEMOD_QUICKJS_ARTIFACTS__";
+const ENTRY_ID: &str = "\0codemod-quickjs-entry";
+
+/// Where the portable orchestration runtime's sources are.
+#[derive(Debug, Clone)]
+pub struct Runtime {
+    /// The orchestration package's `src` directory.
+    pub src: PathBuf,
+}
+
+impl Runtime {
+    fn portable(&self) -> PathBuf {
+        self.src.join("portable.ts")
+    }
+
+    fn entry(&self) -> PathBuf {
+        self.src.join("host").join("quickjs").join("entry.ts")
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct QuickjsBundle {
+    /// The ES module text.
+    pub code: String,
+    /// SHA-256 (hex) of `code`.
+    pub hash: String,
+    /// Sorted by hash.
+    pub artifacts: Vec<JssgArtifact>,
+    /// Every source file that went into the bundle. Sorted.
+    pub inputs: Vec<PathBuf>,
+}
+
+pub(crate) struct BundledArtifact {
+    pub code: String,
+    pub inputs: Vec<PathBuf>,
+}
+
+fn module_type(file: &str) -> ModuleType {
+    match Path::new(file).extension().and_then(|e| e.to_str()) {
+        Some("tsx") => ModuleType::Tsx,
+        Some("jsx") => ModuleType::Jsx,
+        Some("js" | "mjs" | "cjs") => ModuleType::Js,
+        _ => ModuleType::Ts,
+    }
+}
+
+fn is_script(id: &str) -> bool {
+    matches!(
+        Path::new(id).extension().and_then(|e| e.to_str()),
+        Some("ts" | "mts" | "cts" | "tsx" | "js" | "mjs" | "cjs" | "jsx")
+    )
+}
+
+fn external(specifier: &str) -> HookResolveIdOutput {
+    HookResolveIdOutput {
+        id: specifier.into(),
+        external: Some(ResolvedExternal::Bool(true)),
+        ..Default::default()
+    }
+}
+
+/// Errors raised inside hooks, kept whole: rolldown would flatten them into
+/// a generic plugin error.
+#[derive(Default)]
+struct Failure(Mutex<Option<BuildError>>);
+
+impl Failure {
+    fn raise(&self, error: BuildError) -> anyhow::Error {
+        let message = error.to_string();
+        self.0.lock().unwrap().get_or_insert(error);
+        anyhow::anyhow!(message)
+    }
+
+    fn take(&self) -> Option<BuildError> {
+        self.0.lock().unwrap().take()
+    }
+}
+
+// --- transform artifacts ------------------------------------------------------
+
+/// The virtual entry stands in for the workflow module itself (same path), so
+/// its relative imports resolve from the module's directory and the bundle's
+/// region comments name it relative to that directory.
+#[derive(Debug)]
+struct ArtifactEntry {
+    id: String,
+    code: String,
+}
+
+impl Plugin for ArtifactEntry {
+    fn name(&self) -> Cow<'static, str> {
+        Cow::Borrowed("codemod-jssg-artifact")
+    }
+
+    fn register_hook_usage(&self) -> HookUsage {
+        HookUsage::ResolveId | HookUsage::Load
+    }
+
+    async fn resolve_id(
+        &self,
+        _ctx: &PluginContext,
+        args: &HookResolveIdArgs<'_>,
+    ) -> HookResolveIdReturn {
+        if args.specifier == self.id {
+            return Ok(Some(HookResolveIdOutput::from_id(self.id.as_str())));
+        }
+        if args.specifier.starts_with("codemod:") {
+            return Ok(Some(external(args.specifier)));
+        }
+        Ok(None)
+    }
+
+    async fn load(&self, _ctx: &PluginContext, args: &HookLoadArgs<'_>) -> HookLoadReturn {
+        if args.id != self.id {
+            return Ok(None);
+        }
+        Ok(Some(HookLoadOutput {
+            code: ArcStr::from(self.code.as_str()),
+            module_type: Some(module_type(&self.id)),
+            ..Default::default()
+        }))
+    }
+}
+
+/// Bundle one transform's virtual entry into an ES module. The output names
+/// no absolute path (comments are relative to the module's real directory),
+/// so its hash is stable across checkouts. Node built-ins and `codemod:*`
+/// stay external; everything else is inlined.
+pub(crate) async fn bundle_artifact(
+    entry: &str,
+    file: &Path,
+) -> Result<BundledArtifact, BuildError> {
+    let directory = file
+        .parent()
+        .map(|parent| std::fs::canonicalize(parent).unwrap_or_else(|_| parent.to_path_buf()))
+        .unwrap_or_default();
+    let id = directory
+        .join(file.file_name().unwrap_or_default())
+        .to_string_lossy()
+        .into_owned();
+    let fail = |detail: String| BuildError {
+        file: file.to_path_buf(),
+        position: None,
+        message: format!("failed to bundle a jssg transform: {detail}"),
+    };
+    let plugin: SharedPluginable = Arc::new(ArtifactEntry {
+        id: id.clone(),
+        code: entry.to_owned(),
+    });
+    let chunk = generate(
+        BundlerOptions {
+            input: Some(vec![InputItem {
+                name: Some("transform".into()),
+                import: id.clone(),
+            }]),
+            cwd: Some(directory),
+            format: Some(OutputFormat::Esm),
+            platform: Some(Platform::Node),
+            ..Default::default()
+        },
+        vec![plugin],
+    )
+    .await
+    .map_err(fail)?;
+    let mut inputs = vec![file.to_path_buf()];
+    inputs.extend(
+        chunk
+            .module_ids
+            .iter()
+            .filter(|module| **module != id)
+            .filter_map(|module| source_file(module)),
+    );
+    Ok(BundledArtifact {
+        code: chunk.code,
+        inputs,
+    })
+}
+
+struct Chunk {
+    code: String,
+    module_ids: Vec<String>,
+}
+
+async fn generate(
+    options: BundlerOptions,
+    plugins: Vec<SharedPluginable>,
+) -> Result<Chunk, String> {
+    let mut bundler = Bundler::with_plugins(options, plugins).map_err(|e| e.to_string())?;
+    let output = bundler.generate().await.map_err(|e| e.to_string())?;
+    if let Some(unresolved) = output
+        .warnings
+        .iter()
+        .find(|warning| warning.kind().to_string() == "UNRESOLVED_IMPORT")
+    {
+        return Err(unresolved.to_string());
+    }
+    output
+        .assets
+        .into_iter()
+        .find_map(|asset| match asset {
+            Output::Chunk(chunk) => Some(Chunk {
+                code: chunk.code.clone(),
+                module_ids: chunk.module_ids.iter().map(|id| id.to_string()).collect(),
+            }),
+            Output::Asset(_) => None,
+        })
+        .ok_or_else(|| "rolldown produced no chunk".to_owned())
+}
+
+// --- the workflow bundle --------------------------------------------------------
+
+#[derive(Default)]
+struct Collected {
+    artifacts: BTreeMap<String, JssgArtifact>,
+    inputs: BTreeSet<PathBuf>,
+}
+
+struct QuickjsPlugin {
+    runtime: Runtime,
+    workflow_dir: PathBuf,
+    entry: String,
+    collected: Mutex<Collected>,
+    failure: Failure,
+}
+
+impl std::fmt::Debug for QuickjsPlugin {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("QuickjsPlugin").finish_non_exhaustive()
+    }
+}
+
+impl QuickjsPlugin {
+    fn portable(&self) -> HookResolveIdReturn {
+        Ok(Some(HookResolveIdOutput::from_id(
+            self.runtime.portable().to_string_lossy().as_ref(),
+        )))
+    }
+}
+
+impl Plugin for QuickjsPlugin {
+    fn name(&self) -> Cow<'static, str> {
+        Cow::Borrowed("codemod-quickjs")
+    }
+
+    fn register_hook_usage(&self) -> HookUsage {
+        HookUsage::ResolveId | HookUsage::Load | HookUsage::Transform
+    }
+
+    async fn resolve_id(
+        &self,
+        _ctx: &PluginContext,
+        args: &HookResolveIdArgs<'_>,
+    ) -> HookResolveIdReturn {
+        let specifier = args.specifier;
+        if specifier == ENTRY_ID {
+            return Ok(Some(HookResolveIdOutput::from_id(ENTRY_ID)));
+        }
+        if specifier == PACKAGE || specifier == format!("{PACKAGE}/portable") {
+            return self.portable();
+        }
+        if specifier.starts_with(&format!("{PACKAGE}/")) {
+            anyhow::bail!(
+                "'{specifier}' is not available in the quickjs runtime; import '{PACKAGE}' (the portable API)"
+            );
+        }
+        if specifier.starts_with("node:") {
+            anyhow::bail!(
+                "'{specifier}' (imported by {}) is a Node module; the quickjs runtime has no Node APIs",
+                args.importer.unwrap_or("the workflow")
+            );
+        }
+        if specifier.starts_with("codemod:") {
+            return Ok(Some(external(specifier)));
+        }
+        // The package's Node entry, reached by a relative import from inside
+        // the package (tests, demos), is the portable API as well.
+        if specifier.starts_with('.') || Path::new(specifier).is_absolute() {
+            let base = args
+                .importer
+                .filter(|importer| *importer != ENTRY_ID)
+                .and_then(|importer| Path::new(importer).parent())
+                .unwrap_or(&self.workflow_dir);
+            let target = normalize(&base.join(specifier));
+            if target == self.runtime.src.join("index")
+                || target == self.runtime.src.join("index.ts")
+            {
+                return self.portable();
+            }
+        }
+        Ok(None)
+    }
+
+    async fn load(&self, _ctx: &PluginContext, args: &HookLoadArgs<'_>) -> HookLoadReturn {
+        if args.id == ENTRY_ID {
+            return Ok(Some(HookLoadOutput {
+                code: ArcStr::from(self.entry.as_str()),
+                module_type: Some(ModuleType::Js),
+                ..Default::default()
+            }));
+        }
+        let path = Path::new(args.id);
+        // The package's own sources define `jssg`; they never call it.
+        if args.id.starts_with('\0') || !is_script(args.id) || path.starts_with(&self.runtime.src) {
+            return Ok(None);
+        }
+        let Ok(text) = std::fs::read_to_string(path) else {
+            return Ok(None);
+        };
+        if !text.contains("jssg(") {
+            return Ok(None);
+        }
+        let built = build_module(&text, path)
+            .await
+            .map_err(|error| self.failure.raise(error))?;
+        let mut collected = self.collected.lock().unwrap();
+        for artifact in built.artifacts {
+            collected.artifacts.insert(artifact.hash.clone(), artifact);
+        }
+        collected.inputs.extend(built.inputs);
+        Ok(Some(HookLoadOutput {
+            code: ArcStr::from(built.source),
+            module_type: Some(module_type(args.id)),
+            ..Default::default()
+        }))
+    }
+
+    async fn transform(
+        &self,
+        _ctx: SharedTransformPluginContext,
+        args: &HookTransformArgs<'_>,
+    ) -> HookTransformReturn {
+        if !matches!(
+            args.module_type,
+            ModuleType::Js | ModuleType::Jsx | ModuleType::Ts | ModuleType::Tsx
+        ) {
+            return Ok(None);
+        }
+        let id = if args.id == ENTRY_ID {
+            "entry.js"
+        } else {
+            args.id
+        };
+        let code = lower_async(args.code, id, args.module_type)
+            .map_err(|message| anyhow::anyhow!("{id}: {message}"))?;
+        Ok(Some(HookTransformOutput {
+            code: Some(code),
+            module_type: Some(ModuleType::Js),
+            ..Default::default()
+        }))
+    }
+}
+
+/// Strip types and lower async functions and generators (nothing else: the
+/// rest of ES2022 runs as written).
+fn lower_async(code: &str, id: &str, module_type: &ModuleType) -> Result<String, String> {
+    let source_type = match module_type {
+        ModuleType::Ts => SourceType::ts(),
+        ModuleType::Tsx => SourceType::tsx(),
+        ModuleType::Jsx => SourceType::jsx(),
+        _ => SourceType::mjs(),
+    };
+    let allocator = Allocator::default();
+    let parsed = Parser::new(&allocator, code, source_type).parse();
+    if let Some(error) = parsed.errors.first() {
+        return Err(error.message.to_string());
+    }
+    let mut program = parsed.program;
+    let scoping = SemanticBuilder::new()
+        .build(&program)
+        .semantic
+        .into_scoping();
+    let mut options = TransformOptions::default();
+    options.helper_loader.mode = HelperLoaderMode::Runtime;
+    options.env.es2017.async_to_generator = true;
+    options.env.es2018.async_generator_functions = true;
+    let result = Transformer::new(&allocator, Path::new(id), &options)
+        .build_with_scoping(scoping, &mut program);
+    if let Some(error) = result.errors.first() {
+        return Err(error.message.to_string());
+    }
+    Ok(Codegen::new().build(&program).code)
+}
+
+/// A module id that names a file (not a virtual module such as rolldown's
+/// runtime or an oxc helper).
+fn source_file(id: &str) -> Option<PathBuf> {
+    Path::new(id).is_absolute().then(|| PathBuf::from(id))
+}
+
+fn normalize(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::ParentDir => {
+                out.pop();
+            }
+            Component::CurDir => {}
+            other => out.push(other),
+        }
+    }
+    out
+}
+
+/// Build the QuickJS bundle for `workflow` (an absolute path).
+pub async fn build_quickjs_bundle(
+    workflow: &Path,
+    runtime: &Runtime,
+) -> Result<QuickjsBundle, BuildError> {
+    let workflow_dir = workflow.parent().unwrap_or(Path::new("/")).to_path_buf();
+    // The QuickJS entry first, so the host and the async context are
+    // installed before the workflow's modules evaluate.
+    let entry = format!(
+        "import {{ runBundled }} from {};\nimport * as workflow from {};\nexport function main(request) {{ return runBundled(workflow, {ARTIFACTS}, request); }}\n",
+        json(&runtime.entry().to_string_lossy()),
+        json(&workflow.to_string_lossy()),
+    );
+    let plugin = Arc::new(QuickjsPlugin {
+        runtime: runtime.clone(),
+        workflow_dir: workflow_dir.clone(),
+        entry,
+        collected: Mutex::default(),
+        failure: Failure::default(),
+    });
+    let result = generate(
+        BundlerOptions {
+            input: Some(vec![InputItem {
+                name: Some("workflow".into()),
+                import: ENTRY_ID.into(),
+            }]),
+            cwd: Some(workflow_dir),
+            format: Some(OutputFormat::Esm),
+            platform: Some(Platform::Neutral),
+            resolve: Some(ResolveOptions {
+                main_fields: Some(vec!["module".into(), "main".into()]),
+                ..Default::default()
+            }),
+            ..Default::default()
+        },
+        vec![plugin.clone() as SharedPluginable],
+    )
+    .await;
+    if let Some(error) = plugin.failure.take() {
+        return Err(error);
+    }
+    let chunk = result.map_err(|detail| BuildError {
+        file: workflow.to_path_buf(),
+        position: None,
+        message: format!("failed to build the quickjs bundle: {detail}"),
+    })?;
+    let collected = std::mem::take(&mut *plugin.collected.lock().unwrap());
+    let table: serde_json::Map<String, serde_json::Value> = collected
+        .artifacts
+        .values()
+        .map(|artifact| {
+            (
+                artifact.hash.clone(),
+                serde_json::json!({ "name": artifact.name, "source": artifact.source }),
+            )
+        })
+        .collect();
+    let table = serde_json::to_string(&table).expect("the artifact table serializes");
+    let code = format!(
+        "const {ARTIFACTS} = JSON.parse({});\n{}",
+        json(&table),
+        chunk.code
+    );
+    let mut inputs: BTreeSet<PathBuf> = chunk
+        .module_ids
+        .iter()
+        .filter_map(|id| source_file(id))
+        .collect();
+    inputs.extend(collected.inputs);
+    Ok(QuickjsBundle {
+        hash: sha256(&[code.as_bytes()]),
+        code,
+        artifacts: collected.artifacts.into_values().collect(),
+        inputs: inputs.into_iter().collect(),
+    })
+}
+
+fn json(text: &str) -> String {
+    serde_json::to_string(text).expect("a string serializes")
+}
diff --git a/crates/orchestration-build/src/cache.rs b/crates/orchestration-build/src/cache.rs
new file mode 100644
index 00000000..ddf820eb
--- /dev/null
+++ b/crates/orchestration-build/src/cache.rs
@@ -0,0 +1,174 @@
+//! The bundle cache. Entries are keyed by content hashes and validated
+//! against every input file on use, so stale entries are rebuilt rather than
+//! trusted. A directory that is not a real directory owned by this user, or
+//! that others can write to, is never used: the cache holds code that runs.
+use std::{
+    collections::BTreeMap,
+    fs,
+    io::Write,
+    os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt},
+    path::{Path, PathBuf},
+    sync::OnceLock,
+};
+
+use serde::{Deserialize, Serialize};
+
+use crate::{
+    bundle::{build_quickjs_bundle, Runtime},
+    sha256, BuildError,
+};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CachedBundle {
+    pub path: PathBuf,
+    pub hash: String,
+    /// False when this call built the bundle.
+    pub cached: bool,
+}
+
+#[derive(Serialize, Deserialize)]
+struct Manifest {
+    builder: String,
+    workflow: PathBuf,
+    bundle: String,
+    hash: String,
+    inputs: BTreeMap<PathBuf, String>,
+}
+
+/// Identity of this builder (its sources and pinned toolchain): a cached
+/// bundle is reused only by the same build code.
+fn builder() -> &'static str {
+    static BUILDER: OnceLock<String> = OnceLock::new();
+    BUILDER.get_or_init(|| {
+        sha256(&[
+            include_bytes!("../Cargo.toml"),
+            include_bytes!("bundle.rs"),
+            include_bytes!("cache.rs"),
+            include_bytes!("split.rs"),
+        ])
+    })
+}
+
+/// `quickjs/` under `$CODEMOD_WORKFLOW_CACHE`, else under
+/// `<tmpdir>/codemod-workflow-cache-<uid>`. Fails when that directory is not
+/// private to this user.
+pub fn default_bundle_cache() -> Result<PathBuf, String> {
+    let root = match std::env::var_os("CODEMOD_WORKFLOW_CACHE") {
+        Some(root) if !root.is_empty() => PathBuf::from(root),
+        _ => std::env::temp_dir().join(format!("codemod-workflow-cache-{}", uid())),
+    };
+    private_directory("quickjs", &root).ok_or_else(|| {
+        format!(
+            "the workflow cache {} is not a directory private to this user; fix its owner and permissions or set CODEMOD_WORKFLOW_CACHE",
+            root.join("quickjs").display()
+        )
+    })
+}
+
+fn uid() -> u32 {
+    // SAFETY: getuid has no preconditions and cannot fail.
+    unsafe { libc::getuid() }
+}
+
+/// `<root>/<name>`, created (mode 0700) if missing; `None` when the root or
+/// the directory is not private to this user (then nothing is cached).
+pub fn private_directory(name: &str, root: &Path) -> Option<PathBuf> {
+    let is_private = |path: &Path| {
+        fs::symlink_metadata(path)
+            .is_ok_and(|stat| stat.is_dir() && stat.mode() & 0o022 == 0 && stat.uid() == uid())
+    };
+    let create = |path: &Path| {
+        fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(path)
+    };
+    // The root is checked before anything is created inside it.
+    create(root).ok()?;
+    if !is_private(root) {
+        return None;
+    }
+    let directory = root.join(name);
+    create(&directory).ok()?;
+    is_private(&directory).then_some(directory)
+}
+
+fn file_hash(path: &Path) -> Option<String> {
+    fs::read(path).ok().map(|bytes| sha256(&[&bytes]))
+}
+
+/// Write via a temporary file and a rename, so readers never see a partial entry.
+fn atomic_write(path: &Path, content: &str) -> std::io::Result<()> {
+    let temporary = path.with_extension(format!("{}.tmp", std::process::id()));
+    fs::OpenOptions::new()
+        .write(true)
+        .create(true)
+        .truncate(true)
+        .mode(0o600)
+        .open(&temporary)?
+        .write_all(content.as_bytes())?;
+    fs::rename(&temporary, path)
+}
+
+fn cached(manifest_path: &Path, cache: &Path, workflow: &Path) -> Option<CachedBundle> {
+    let manifest: Manifest = serde_json::from_slice(&fs::read(manifest_path).ok()?).ok()?;
+    let bundle = cache.join(&manifest.bundle);
+    let valid = manifest.builder == builder()
+        && manifest.workflow == workflow
+        && file_hash(&bundle).as_deref() == Some(manifest.hash.as_str())
+        && manifest
+            .inputs
+            .iter()
+            .all(|(input, hash)| file_hash(input).as_deref() == Some(hash.as_str()));
+    valid.then_some(CachedBundle {
+        path: bundle,
+        hash: manifest.hash,
+        cached: true,
+    })
+}
+
+/// The bundle for `workflow` from `cache`, rebuilt only when an input file
+/// (the workflow graph, the runtime sources, bundled packages) or this
+/// builder changed since it was cached. Bundles are stored by content hash.
+pub async fn cached_quickjs_bundle(
+    workflow: &Path,
+    runtime: &Runtime,
+    cache: &Path,
+) -> Result<CachedBundle, BuildError> {
+    let workflow = std::path::absolute(workflow).unwrap_or_else(|_| workflow.to_path_buf());
+    let key = sha256(&[builder().as_bytes(), workflow.to_string_lossy().as_bytes()]);
+    let manifest_path = cache.join(format!("{key}.json"));
+    if let Some(hit) = cached(&manifest_path, cache, &workflow) {
+        return Ok(hit);
+    }
+    let built = build_quickjs_bundle(&workflow, runtime).await?;
+    let io_error = |error: std::io::Error| BuildError {
+        file: cache.to_path_buf(),
+        position: None,
+        message: format!("cannot write the bundle cache: {error}"),
+    };
+    fs::create_dir_all(cache).map_err(io_error)?;
+    let bundle_name = format!("{}.mjs", built.hash);
+    let bundle_path = cache.join(&bundle_name);
+    if file_hash(&bundle_path).as_deref() != Some(built.hash.as_str()) {
+        atomic_write(&bundle_path, &built.code).map_err(io_error)?;
+    }
+    let manifest = Manifest {
+        builder: builder().to_owned(),
+        workflow,
+        bundle: bundle_name,
+        hash: built.hash.clone(),
+        inputs: built
+            .inputs
+            .iter()
+            .map(|input| (input.clone(), file_hash(input).unwrap_or_default()))
+            .collect(),
+    };
+    let manifest = serde_json::to_string(&manifest).expect("the manifest serializes");
+    atomic_write(&manifest_path, &manifest).map_err(io_error)?;
+    Ok(CachedBundle {
+        path: bundle_path,
+        hash: built.hash,
+        cached: false,
+    })
+}
diff --git a/crates/orchestration-build/src/lib.rs b/crates/orchestration-build/src/lib.rs
new file mode 100644
index 00000000..9dd6899f
--- /dev/null
+++ b/crates/orchestration-build/src/lib.rs
@@ -0,0 +1,58 @@
+//! Builds a TypeScript orchestration workflow into one self-contained ES
+//! module for the QuickJS host (`orchestration-quickjs-host`):
+//!
+//! - [`build_module`] splits a workflow module: every inline `jssg()`
+//!   transform becomes its own bundled artifact, identified by content hash,
+//!   and the call is rewritten to reference it.
+//! - [`build_quickjs_bundle`] bundles the workflow graph with the portable
+//!   orchestration runtime, async lowered, with the artifact table in front.
+//! - [`cached_quickjs_bundle`] reuses a bundle until an input file or this
+//!   builder changes.
+mod bundle;
+mod cache;
+mod split;
+
+use std::{fmt, path::PathBuf};
+
+pub use bundle::{build_quickjs_bundle, QuickjsBundle, Runtime};
+pub use cache::{cached_quickjs_bundle, default_bundle_cache, private_directory, CachedBundle};
+pub use split::{build_file, build_module, BuiltModule, JssgArtifact};
+
+/// A workflow outside the supported subset, or a bundling failure.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BuildError {
+    pub file: PathBuf,
+    /// 1-based line and column (UTF-16 code units, as editors count them).
+    pub position: Option<(usize, usize)>,
+    pub message: String,
+}
+
+impl fmt::Display for BuildError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.position {
+            Some((line, column)) => {
+                write!(
+                    f,
+                    "{}:{line}:{column}: {}",
+                    self.file.display(),
+                    self.message
+                )
+            }
+            None => write!(f, "{}: {}", self.file.display(), self.message),
+        }
+    }
+}
+
+impl std::error::Error for BuildError {}
+
+pub(crate) fn sha256(parts: &[&[u8]]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut hash = Sha256::new();
+    for (index, part) in parts.iter().enumerate() {
+        if index > 0 {
+            hash.update(b"\0");
+        }
+        hash.update(part);
+    }
+    hex::encode(hash.finalize())
+}
diff --git a/crates/orchestration-build/src/split.rs b/crates/orchestration-build/src/split.rs
new file mode 100644
index 00000000..dd4f8e94
--- /dev/null
+++ b/crates/orchestration-build/src/split.rs
@@ -0,0 +1,430 @@
+//! The `jssg()` split. Every `jssg({ ..., transform })` call in a workflow
+//! module becomes an artifact: the transform's own source text, with the
+//! import declarations it uses, bundled into an ES module whose default
+//! export is the transform. The call is rewritten so `transform` is an
+//! `ArtifactRef` (`{ name, hash }`); no function is ever serialized.
+//!
+//! Supported subset: a transform may use its own parameters and locals,
+//! globals, and bindings the module imports from other modules (those are
+//! bundled). It may not use anything else declared in the workflow module;
+//! such captures are rejected with the source position. `name` must be a
+//! string literal; `transform` must be a method, a function or arrow
+//! expression, or an imported binding.
+use std::{
+    collections::BTreeSet,
+    path::{Path, PathBuf},
+};
+
+use oxc::{
+    allocator::Allocator,
+    ast::{
+        ast::{
+            Argument, Expression, ObjectExpression, ObjectProperty, ObjectPropertyKind,
+            PropertyKey, PropertyKind, Statement,
+        },
+        AstKind,
+    },
+    parser::Parser,
+    semantic::{Semantic, SemanticBuilder, SymbolId},
+    span::{GetSpan, SourceType, Span},
+};
+
+use crate::{bundle::bundle_artifact, sha256, BuildError};
+
+const ORCHESTRATION_PACKAGE: &str = "@codemod.com/orchestration";
+
+/// One bundled transform. `source` is what a runtime executes; `hash` identifies it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct JssgArtifact {
+    pub name: String,
+    pub hash: String,
+    pub source: String,
+    /// The module the transform was extracted from, for messages only.
+    pub origin: PathBuf,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BuiltModule {
+    /// The module with every inline transform replaced by its `ArtifactRef`.
+    pub source: String,
+    pub artifacts: Vec<JssgArtifact>,
+    /// Every file bundled into the artifacts, the module itself included
+    /// (for build caches). Sorted.
+    pub inputs: Vec<PathBuf>,
+}
+
+/// Read and split a module on disk.
+pub async fn build_file(file: &Path) -> Result<BuiltModule, BuildError> {
+    let source = std::fs::read_to_string(file).map_err(|error| BuildError {
+        file: file.to_path_buf(),
+        position: None,
+        message: error.to_string(),
+    })?;
+    build_module(&source, file).await
+}
+
+/// Split one module. `file` must be absolute: the transforms' relative
+/// imports resolve from its directory.
+pub async fn build_module(source: &str, file: &Path) -> Result<BuiltModule, BuildError> {
+    // The AST is not `Send`, so the analysis finishes before any bundling.
+    let plan = analyze(source, file)?;
+    let mut edits = plan.removed_imports;
+    let mut artifacts = Vec::new();
+    let mut inputs = BTreeSet::new();
+    for extraction in plan.extractions {
+        let bundled = bundle_artifact(&extraction.entry, file).await?;
+        inputs.extend(bundled.inputs);
+        let hash = sha256(&[bundled.code.as_bytes()]);
+        edits.push(Edit {
+            span: extraction.property,
+            text: format!(
+                "transform: {{\"name\":{},\"hash\":{}}}",
+                json_string(&extraction.name),
+                json_string(&hash)
+            ),
+        });
+        artifacts.push(JssgArtifact {
+            name: extraction.name,
+            hash,
+            source: bundled.code,
+            origin: file.to_path_buf(),
+        });
+    }
+    edits.sort_by_key(|edit| std::cmp::Reverse(edit.span.start));
+    let mut rewritten = source.to_owned();
+    for edit in edits {
+        rewritten.replace_range(edit.span.start as usize..edit.span.end as usize, &edit.text);
+    }
+    Ok(BuiltModule {
+        source: rewritten,
+        artifacts,
+        inputs: inputs.into_iter().collect(),
+    })
+}
+
+struct Edit {
+    span: Span,
+    text: String,
+}
+
+struct Extraction {
+    name: String,
+    /// The virtual entry module: the imports the transform uses, then
+    /// `export default <transform>`.
+    entry: String,
+    property: Span,
+}
+
+struct Plan {
+    extractions: Vec<Extraction>,
+    removed_imports: Vec<Edit>,
+}
+
+struct Import {
+    span: Span,
+    source: String,
+    symbols: Vec<SymbolId>,
+}
+
+struct Module<'s, 'a> {
+    source: &'s str,
+    file: &'s Path,
+    semantic: Semantic<'a>,
+    imports: Vec<Import>,
+}
+
+fn analyze(source: &str, file: &Path) -> Result<Plan, BuildError> {
+    let allocator = Allocator::default();
+    let source_type = SourceType::from_path(file).unwrap_or_else(|_| SourceType::ts());
+    let parsed = Parser::new(&allocator, source, source_type).parse();
+    if let Some(error) = parsed.errors.first() {
+        let start = error
+            .labels
+            .as_ref()
+            .and_then(|labels| labels.first())
+            .map(|label| label.offset() as u32);
+        return Err(BuildError {
+            file: file.to_path_buf(),
+            position: start.map(|start| position(source, start)),
+            message: error.message.to_string(),
+        });
+    }
+    let program = allocator.alloc(parsed.program);
+    let semantic = SemanticBuilder::new().build(program).semantic;
+    let imports = program
+        .body
+        .iter()
+        .filter_map(|statement| match statement {
+            Statement::ImportDeclaration(declaration) => Some(Import {
+                span: declaration.span,
+                source: declaration.source.value.to_string(),
+                symbols: declaration
+                    .specifiers
+                    .iter()
+                    .flatten()
+                    .map(|specifier| specifier.local().symbol_id())
+                    .collect(),
+            }),
+            _ => None,
+        })
+        .collect();
+    let module = Module {
+        source,
+        file,
+        semantic,
+        imports,
+    };
+
+    let mut extractions = Vec::new();
+    for node in module.semantic.nodes().iter() {
+        let AstKind::CallExpression(call) = node.kind() else {
+            continue;
+        };
+        if !matches!(&call.callee, Expression::Identifier(callee) if callee.name == "jssg") {
+            continue;
+        }
+        let Some(Argument::ObjectExpression(argument)) = call.arguments.first() else {
+            return Err(module.fail(
+                call.span,
+                "jssg() must be called with an object literal so its transform can be extracted",
+            ));
+        };
+        let Some(name) = literal_property(argument, "name") else {
+            return Err(module.fail(argument.span, "jssg name must be a string literal"));
+        };
+        let Some(property) = find_property(argument, "transform") else {
+            return Err(module.fail(argument.span, &format!("jssg '{name}' has no transform")));
+        };
+        let span = property.span;
+        let entry = module.transform_entry(property, &name)?;
+        extractions.push(Extraction {
+            name,
+            entry,
+            property: span,
+        });
+    }
+    let extracted: Vec<Span> = extractions.iter().map(|e| e.property).collect();
+    let removed_imports = module.imports_only_transforms_use(&extracted);
+    Ok(Plan {
+        extractions,
+        removed_imports,
+    })
+}
+
+impl Module<'_, '_> {
+    fn fail(&self, span: Span, message: &str) -> BuildError {
+        BuildError {
+            file: self.file.to_path_buf(),
+            position: Some(position(self.source, span.start)),
+            message: message.to_owned(),
+        }
+    }
+
+    fn text(&self, span: Span) -> &str {
+        &self.source[span.start as usize..span.end as usize]
+    }
+
+    fn transform_entry(&self, property: &ObjectProperty, name: &str) -> Result<String, BuildError> {
+        if property.kind != PropertyKind::Init {
+            return Err(self.fail(
+                property.span,
+                &format!("jssg '{name}' transform must be a method or property"),
+            ));
+        }
+        let (body, range) = if property.method {
+            let Expression::FunctionExpression(function) = &property.value else {
+                unreachable!("an object method's value is a function");
+            };
+            if function.generator {
+                return Err(self.fail(
+                    property.span,
+                    &format!("jssg '{name}' transform cannot be a generator"),
+                ));
+            }
+            if function.body.is_none() {
+                return Err(self.fail(
+                    property.span,
+                    &format!("jssg '{name}' transform has no body"),
+                ));
+            }
+            let signature = Span::new(property.key.span().end, property.span.end);
+            let body = format!(
+                "export default {}function transform{}",
+                if function.r#async { "async " } else { "" },
+                self.text(signature)
+            );
+            (body, property.span)
+        } else {
+            match &property.value {
+                Expression::FunctionExpression(_) | Expression::ArrowFunctionExpression(_) => {
+                    let span = property.value.span();
+                    (format!("export default ({});", self.text(span)), span)
+                }
+                Expression::Identifier(identifier) => (
+                    format!("export default {};", identifier.name),
+                    identifier.span,
+                ),
+                value => {
+                    return Err(self.fail(
+                        value.span(),
+                        &format!("jssg '{name}' transform must be a method, a function or arrow expression, or an imported binding"),
+                    ))
+                }
+            }
+        };
+
+        let mut imports = BTreeSet::new();
+        for (symbol, reference) in self.module_references(range) {
+            if let Some(index) = self
+                .imports
+                .iter()
+                .position(|i| i.symbols.contains(&symbol))
+            {
+                let import = &self.imports[index];
+                if import.source == ORCHESTRATION_PACKAGE
+                    || import
+                        .source
+                        .starts_with(&format!("{ORCHESTRATION_PACKAGE}/"))
+                {
+                    return Err(self.fail(
+                        reference,
+                        &format!(
+                            "jssg '{name}' transform uses '{}' from {ORCHESTRATION_PACKAGE}; the orchestration runtime is not available inside a transform",
+                            self.symbol_name(symbol)
+                        ),
+                    ));
+                }
+                imports.insert(index);
+                continue;
+            }
+            let scoping = self.semantic.scoping();
+            if scoping.symbol_flags(symbol).is_value() {
+                let identifier = self.symbol_name(symbol);
+                let (line, _) = position(self.source, scoping.symbol_span(symbol).start);
+                return Err(self.fail(
+                    reference,
+                    &format!(
+                        "jssg '{name}' transform uses '{identifier}', declared in the workflow module at line {line}; a transform can only use its own code, globals, and imported bindings. Move '{identifier}' into a module and import it, or pass it through invocation input"
+                    ),
+                ));
+            }
+        }
+        let imports: Vec<&str> = imports
+            .into_iter()
+            .map(|index| self.text(self.imports[index].span))
+            .collect();
+        Ok(format!("{}\n{body}\n", imports.join("\n")))
+    }
+
+    fn symbol_name(&self, symbol: SymbolId) -> &str {
+        self.semantic.scoping().symbol_name(symbol)
+    }
+
+    /// Module-level bindings referenced as values inside `range`, each with
+    /// its first reference, in source order. Names bound inside the
+    /// transform resolve to their own scopes and never appear here.
+    fn module_references(&self, range: Span) -> Vec<(SymbolId, Span)> {
+        let scoping = self.semantic.scoping();
+        let mut found: Vec<(SymbolId, Span)> = scoping
+            .iter_bindings_in(scoping.root_scope_id())
+            .filter_map(|symbol| {
+                scoping
+                    .get_resolved_references(symbol)
+                    .filter(|reference| reference.flags().is_value())
+                    .map(|reference| self.semantic.nodes().get_node(reference.node_id()).span())
+                    .filter(|span| contains(range, *span))
+                    .min_by_key(|span| span.start)
+                    .map(|span| (symbol, span))
+            })
+            .collect();
+        found.sort_by_key(|(_, span)| span.start);
+        found
+    }
+
+    /// Imports used only inside extracted transforms live in the artifacts
+    /// now. Keeping them would make the runner evaluate transform modules
+    /// (and their `codemod:*` imports, which only the runtimes resolve).
+    fn imports_only_transforms_use(&self, extracted: &[Span]) -> Vec<Edit> {
+        let scoping = self.semantic.scoping();
+        let inside = |span: Span| extracted.iter().any(|range| contains(*range, span));
+        self.imports
+            .iter()
+            .filter(|import| {
+                let spans: Vec<Span> = import
+                    .symbols
+                    .iter()
+                    .flat_map(|symbol| scoping.get_resolved_references(*symbol))
+                    .map(|reference| self.semantic.nodes().get_node(reference.node_id()).span())
+                    .collect();
+                !import.symbols.is_empty()
+                    && spans.iter().all(|span| inside(*span))
+                    && !spans.is_empty()
+            })
+            .map(|import| Edit {
+                span: import.span,
+                text: String::new(),
+            })
+            .collect()
+    }
+}
+
+fn contains(range: Span, span: Span) -> bool {
+    span.start >= range.start && span.start < range.end
+}
+
+fn property_name<'a>(property: &'a ObjectProperty) -> Option<&'a str> {
+    if property.computed {
+        return None;
+    }
+    match &property.key {
+        PropertyKey::StaticIdentifier(identifier) => Some(identifier.name.as_str()),
+        PropertyKey::StringLiteral(literal) => Some(literal.value.as_str()),
+        _ => None,
+    }
+}
+
+fn find_property<'o, 'a>(
+    object: &'o ObjectExpression<'a>,
+    key: &str,
+) -> Option<&'o ObjectProperty<'a>> {
+    object
+        .properties
+        .iter()
+        .find_map(|property| match property {
+            ObjectPropertyKind::ObjectProperty(property)
+                if property_name(property) == Some(key) =>
+            {
+                Some(&**property)
+            }
+            _ => None,
+        })
+}
+
+fn literal_property(object: &ObjectExpression, key: &str) -> Option<String> {
+    let property = find_property(object, key)?;
+    if property.kind != PropertyKind::Init || property.method || property.shorthand {
+        return None;
+    }
+    match &property.value {
+        Expression::StringLiteral(literal) => Some(literal.value.to_string()),
+        Expression::TemplateLiteral(template) if template.expressions.is_empty() => template
+            .quasis
+            .first()
+            .and_then(|quasi| quasi.value.cooked)
+            .map(|cooked| cooked.to_string()),
+        _ => None,
+    }
+}
+
+/// 1-based line and column of a byte offset; columns count UTF-16 code units.
+pub(crate) fn position(source: &str, offset: u32) -> (usize, usize) {
+    let before = &source[..offset as usize];
+    let line_start = before.rfind('\n').map_or(0, |index| index + 1);
+    let line = before.matches('\n').count() + 1;
+    let column = before[line_start..].encode_utf16().count() + 1;
+    (line, column)
+}
+
+fn json_string(text: &str) -> String {
+    serde_json::to_string(text).expect("a string serializes")
+}
