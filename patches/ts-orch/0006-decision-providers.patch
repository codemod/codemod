+    throw new Error(
+      `DECISION_PROVIDER '${provider}' is not one of ${DECISION_PROVIDERS.join(", ")}`,
+    );
+  }
+  return provider as DecisionProvider;
+}
+
+const setting = (
+  env: Env,
+  provider: DecisionProvider,
+  name: "baseURL" | "model" | "apiKey",
+  variable: string,
