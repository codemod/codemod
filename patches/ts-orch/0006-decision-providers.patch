new file mode 100644
index 00000000..d6a98c5e
--- /dev/null
+++ b/packages/orchestration/src/execution/decision/openai.ts
@@ -0,0 +1,120 @@
+/**
+ * OpenAI's Decisions API (`POST /v1/decisions`, model `gpt-6-luna`).
+ * Questions are an array of `{ name, type, instructions }`: yes/no is
+ * `predicate` (its criteria are appended to the instructions, which take text
+ * only), choice options are `choices`, and score levels are `levels` (2 to 10).
+ * Answers come back as an array matched by name; a `refusal` becomes
+ * `{ type: "refused" }`. Usage reports input tokens only.
+ */
+import type { AssessmentQuestion } from "../../core/assessment.ts";
+import { isRecord } from "../../core/protocol.ts";
+import { asText, type DecisionAdapter } from "./adapter.ts";
+
+const MAX_QUESTIONS = 400;
+const MAX_LEVELS = 10;
+
+function encodeQuestion(name: string, question: AssessmentQuestion): unknown {
+  const instructions = asText(question.instructions);
+  if (question.type === "yesno") {
+    const { yes, no } = question.criteria ?? {};
+    const rubric = [
+      yes == null ? "" : `\n\nAnswer yes when: ${asText(yes)}`,
+      no == null ? "" : `\n\nAnswer no when: ${asText(no)}`,
+    ].join("");
+    return { type: "predicate", name, instructions: instructions + rubric };
+  }
+  if (question.type === "choice") {
+    const choices = Object.entries(question.criteria).map(([value, description]) => ({
+      value,
+      description: description == null ? value : asText(description),
+    }));
+    return { type: "choice", name, instructions, choices };
+  }
+  const levels = question.criteria.map((description, index) => ({
+    label: String(index),
+    description: description == null ? `level ${index}` : asText(description),
+  }));
+  return { type: "score", name, instructions, levels };
+}
+
+const byValue = (entries: unknown, key: string): unknown =>
+  Array.isArray(entries) && entries.every((e) => isRecord(e) && key in e && "probability" in e)
+    ? Object.fromEntries(
+        entries.map((e: Record<string, unknown>) => [String(e[key]), e.probability]),
+      )
+    : entries;
+
+function decodeAnswer(answer: Record<string, unknown>, question: AssessmentQuestion | undefined) {
+  switch (answer.type) {
+    case "refusal":
+      return { type: "refused" };
+    case "predicate":
+      return { type: "yesno", yes: answer.probability };
+    case "choice":
+      return {
+        type: "choice",
+        choice: answer.choice,
+        probabilities: byValue(answer.probabilities, "value"),
+        confidence: answer.confidence,
+      };
+    case "score":
+      return {
+        type: "score",
+        score: answer.score,
+        legend:
+          question?.type === "score"
+            ? Object.fromEntries(question.criteria.map((entry, index) => [String(index), entry]))
+            : undefined,
+        probabilities: byValue(answer.probabilities, "value"),
+        confidence: answer.confidence,
+      };
+    default:
+      return answer;
+  }
+}
+
+export const openai: DecisionAdapter = {
+  calibrated: true,
+  encode({ state, questions, model }) {
+    const entries = Object.entries(questions);
+    if (entries.length > MAX_QUESTIONS) {
+      return { problem: `openai decisions take at most ${MAX_QUESTIONS} questions per request` };
+    }
+    const wide = entries.find(([, q]) => q.type === "score" && q.criteria.length > MAX_LEVELS);
+    if (wide !== undefined) {
+      return {
+        problem: `question '${wide[0]}': openai decisions take at most ${MAX_LEVELS} score levels`,
+      };
+    }
+    const input =
+      typeof state === "string"
+        ? state
+        : [{ role: "user", content: [{ type: "input_json", data: state }] }];
+    return {
+      body: { model, input, questions: entries.map(([name, q]) => encodeQuestion(name, q)) },
+    };
+  },
+  decode(body, request) {
+    if (!isRecord(body) || !Array.isArray(body.answers))
+      return { problem: "answers must be an array" };
+    const answers: [string, unknown][] = [];
+    const seen = new Set<string>();
+    for (const answer of body.answers) {
+      if (!isRecord(answer) || typeof answer.name !== "string") {
+        return { problem: "each answer must be an object with a name" };
+      }
+      if (seen.has(answer.name)) return { problem: `answers repeat '${answer.name}'` };
+      seen.add(answer.name);
+      const question = Object.hasOwn(request.questions, answer.name)
+        ? request.questions[answer.name]
+        : undefined;
+      answers.push([answer.name, decodeAnswer(answer, question)]);
+    }
+    const usage = isRecord(body.usage) ? body.usage : {};
+    return {
+      model: typeof body.model === "string" ? body.model : request.model,
+      answers: Object.fromEntries(answers),
+      usage: usage.input_tokens == null ? {} : { inputTokens: usage.input_tokens },
+    };
+  },
+};
diff --git a/packages/orchestration/src/execution/decision/systemone.ts b/packages/orchestration/src/execution/decision/systemone.ts
new file mode 100644
index 00000000..bfe57283
--- /dev/null
+++ b/packages/orchestration/src/execution/decision/systemone.ts
@@ -0,0 +1,60 @@
+/**
+ * The System One API (`POST /v1/systemone`): TypeSafe's Jev, Liquid AI d1,
+ * open servers that speak it, and Microsoft Decision through Azure AI Foundry
+ * (`DECISION_PATH=/providers/microsoft/v1/systemone`, `DECISION_AUTH_HEADER=api-key`,
+ * the deployment name as `DECISION_MODEL`). Questions are a map keyed by id,
+ * and yes/no questions are its `noul` type.
+ */
+import type { AssessmentQuestion } from "../../core/assessment.ts";
+import { isRecord } from "../../core/protocol.ts";
+import type { DecisionAdapter } from "./adapter.ts";
+
+const ANSWER_FIELDS: Record<string, readonly string[]> = {
+  choice: ["choice", "probabilities", "confidence"],
+  score: ["score", "legend", "probabilities", "confidence"],
+};
+
+function encodeQuestion(question: AssessmentQuestion): unknown {
+  if (question.type !== "yesno") return question;
+  const { criteria } = question;
+  return {
+    type: "noul",
+    instructions: question.instructions,
+    ...(criteria === undefined ? {} : { criteria: { true: criteria.yes, false: criteria.no } }),
+  };
+}
+
+function decodeAnswer(answer: unknown): unknown {
+  if (!isRecord(answer)) return answer;
+  if (answer.type === "noul") return { type: "yesno", yes: answer.noul };
+  const fields = ANSWER_FIELDS[answer.type as string];
+  if (fields === undefined || !Object.hasOwn(ANSWER_FIELDS, answer.type as string)) return answer;
+  // Only the documented fields reach history; fields the API adds later are dropped.
+  return Object.fromEntries(
+    ["type", ...fields].filter((f) => Object.hasOwn(answer, f)).map((f) => [f, answer[f]]),
+  );
+}
+
+export const systemone: DecisionAdapter = {
+  calibrated: true,
+  encode({ state, questions, model }) {
+    const encoded = Object.entries(questions).map(([id, q]) => [id, encodeQuestion(q)]);
+    return { body: { state, questions: Object.fromEntries(encoded), model } };
+  },
+  decode(body) {
+    if (!isRecord(body) || !isRecord(body.answers)) return { problem: "answers must be an object" };
+    if (body.usage != null && !isRecord(body.usage)) return { problem: "usage must be an object" };
+    const usage = body.usage ?? {};
+    const counts = [
+      ["inputTokens", usage.input_tokens],
+      ["outputTokens", usage.output_tokens],
+    ].filter(([, count]) => count != null);
+    return {
+      model: body.model,
+      answers: Object.fromEntries(
+        Object.entries(body.answers).map(([id, answer]) => [id, decodeAnswer(answer)]),
+      ),
+      usage: Object.fromEntries(counts),
+    };
+  },
+};
diff --git a/packages/orchestration/src/execution/decision/transport.ts b/packages/orchestration/src/execution/decision/transport.ts
new file mode 100644
index 00000000..e19c940a
--- /dev/null
+++ b/packages/orchestration/src/execution/decision/transport.ts
@@ -0,0 +1,203 @@
+/**
+ * One JSON POST to a decision API, with a per-attempt timeout, retries and
+ * abort. Ported from the policy the TypeSafe SDK used, so behavior did not
+ * change when the SDK was dropped: two retries with jittered exponential
+ * backoff (500 ms doubling to 5 s), on connection errors, timeouts, and HTTP
+ * 408, 409, 429 and 5xx, waiting for `retry-after-ms` / `Retry-After` when the
+ * server sends it (up to 60 s).
+ *
+ * Failures are thrown as `DecisionRequestError`, whose `phase` and `details`
+ * become the failed completion's; an abort is thrown as `DecisionAbortError`.
+ */
+import type { Json } from "../../core/json.ts";
+import { getHost } from "../../core/host.ts";
+
+/** The part of `fetch` used here; the QuickJS host passes its own. */
+export type DecisionFetch = (
+  url: string,
+  init: { method: string; headers: Record<string, string>; body: string; signal: AbortSignal },
+) => Promise<{
+  status: number;
+  headers: { get(name: string): string | null };
+  text(): Promise<string>;
+}>;
+
+export interface RetryPolicy {
+  maxRetries: number;
+  initialDelayMs: number;
+  maxDelayMs: number;
+  /** Fraction of each delay drawn at random, 0 to 1. */
+  jitter: number;
+}
+
+export const DEFAULT_RETRY: RetryPolicy = {
+  maxRetries: 2,
+  initialDelayMs: 500,
+  maxDelayMs: 5_000,
+  jitter: 0.25,
+};
+const MAX_RETRY_AFTER_MS = 60_000;
+const ERROR_BODY_LIMIT = 2_000;
+
+export class DecisionRequestError extends Error {
+  constructor(
+    message: string,
+    readonly details: { [key: string]: Json },
+  ) {
+    super(message);
+  }
+}
+
+export class DecisionAbortError extends Error {}
+
+export interface PostOptions {
+  url: string;
+  headers: Record<string, string>;
+  body: unknown;
+  fetch: DecisionFetch;
+  timeoutMs: number;
+  retry: RetryPolicy;
+  signal?: AbortSignal;
+}
+
+const retryableStatus = (status: number) =>
+  status === 408 || status === 409 || status === 429 || status >= 500;
+
+/** POST `body` as JSON and return the parsed 2xx response body. */
+export async function postJson(options: PostOptions): Promise<unknown> {
+  const body = JSON.stringify(options.body);
+  for (let attempt = 0; ; attempt++) {
+    let retryAfterMs: number | undefined;
+    try {
+      const response = await attemptOnce(options, body);
+      const text = await response.text();
+      if (response.status >= 200 && response.status < 300) {
+        try {
+          return JSON.parse(text) as unknown;
+        } catch {
+          throw new DecisionRequestError("decision API returned a body that is not JSON", {
+            phase: "response",
+            status: response.status,
+          });
+        }
+      }
+      retryAfterMs = retryAfter(response.headers);
+      throw new DecisionRequestError(`decision API responded ${response.status}`, {
+        phase: "http",
+        status: response.status,
+        retryable: retryableStatus(response.status),
+        ...httpDetails(response.headers, text, retryAfterMs),
+      });
+    } catch (error) {
+      if (error instanceof DecisionAbortError) throw error;
+      const failure =
+        error instanceof DecisionRequestError
+          ? error
+          : new DecisionRequestError(`decision request failed: ${messageOf(error)}`, {
+              phase: "internal",
+            });
+      if (failure.details.retryable !== true || attempt >= options.retry.maxRetries) {
+        throw failure;
+      }
+    }
+    await sleep(retryAfterMs ?? backoff(options.retry, attempt), options.signal);
+  }
+}
+
+async function attemptOnce(options: PostOptions, body: string) {
+  const { signal } = options;
+  if (signal?.aborted) throw new DecisionAbortError("aborted");
+  const host = getHost();
+  const controller = new AbortController();
+  let timedOut = false;
+  const timer = host.setTimeout(() => {
+    timedOut = true;
+    controller.abort();
+  }, options.timeoutMs);
+  const onAbort = () => controller.abort();
+  signal?.addEventListener("abort", onAbort, { once: true });
+  try {
+    return await options.fetch(options.url, {
+      method: "POST",
+      headers: {
+        ...options.headers,
+        accept: "application/json",
+        "content-type": "application/json",
+      },
+      body,
+      signal: controller.signal,
+    });
+  } catch (error) {
+    if (signal?.aborted) throw new DecisionAbortError("aborted");
+    if (timedOut) {
+      throw new DecisionRequestError(`decision request timed out after ${options.timeoutMs}ms`, {
+        phase: "request",
+        timedOut: true,
+        retryable: true,
+      });
+    }
+    throw new DecisionRequestError(`decision request failed: ${messageOf(error)}`, {
+      phase: "request",
+      retryable: true,
+    });
+  } finally {
+    host.clearTimeout(timer);
+    signal?.removeEventListener("abort", onAbort);
+  }
+}
+
+function httpDetails(
+  headers: { get(name: string): string | null },
+  text: string,
+  retryAfterMs: number | undefined,
+): { [key: string]: Json } {
+  const details: { [key: string]: Json } = {};
+  const requestId = headers.get("x-request-id") ?? headers.get("apim-request-id");
+  if (requestId !== null) details.requestId = requestId;
+  if (retryAfterMs !== undefined) details.retryAfterMs = retryAfterMs;
+  if (text !== "") {
+    let parsed: Json = text;
+    try {
+      parsed = JSON.parse(text) as Json;
+    } catch {}
+    details.body = text.length > ERROR_BODY_LIMIT ? `${text.slice(0, ERROR_BODY_LIMIT)}…` : parsed;
+  }
+  return details;
+}
+
+function retryAfter(headers: { get(name: string): string | null }): number | undefined {
+  const milliseconds = Number(headers.get("retry-after-ms") ?? Number.NaN);
+  let delay = Number.isFinite(milliseconds) ? milliseconds : undefined;
+  const header = headers.get("retry-after");
+  if (delay === undefined && header !== null) {
+    const seconds = Number(header);
+    delay = Number.isFinite(seconds) ? seconds * 1000 : Date.parse(header) - Date.now();
+    if (!Number.isFinite(delay)) delay = undefined;
+  }
+  return delay !== undefined && delay >= 0 && delay <= MAX_RETRY_AFTER_MS ? delay : undefined;
+}
+
+function backoff(policy: RetryPolicy, attempt: number): number {
+  const delay = Math.min(policy.maxDelayMs, policy.initialDelayMs * 2 ** attempt);
+  return delay * (1 - policy.jitter * Math.random());
+}
+
+function sleep(ms: number, signal: AbortSignal | undefined): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) return reject(new DecisionAbortError("aborted"));
+    const host = getHost();
+    const onAbort = () => {
+      host.clearTimeout(timer);
+      reject(new DecisionAbortError("aborted"));
+    };
+    const timer = host.setTimeout(() => {
+      signal?.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+    signal?.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+export function messageOf(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
