+  systemone: {
+    baseURL: "https://api.typesafe.ai",
+    path: "/v1/systemone",
+    model: "jev-latest",
+    legacy: {
+      baseURL: "TYPESAFE_BASE_URL",
+      model: "TYPESAFE_DEFAULT_MODEL",
+      apiKey: "TYPESAFE_API_KEY",
+    },
+  },
+  openai: {
+    baseURL: "https://api.openai.com",
+    path: "/v1/decisions",
+    model: "gpt-6-luna",
+    legacy: { apiKey: "OPENAI_API_KEY" },
+  },
+};
