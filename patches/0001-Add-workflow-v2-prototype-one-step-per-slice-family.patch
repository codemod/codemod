+// Generated by build.mjs from src/main-single.ts; do not edit.
+import { forEachFile, parse, shell, step } from "codemod:workflow";
+// ../src/engine/define-slice.ts
+function defineSlice(definition) {
+  const languages = new Set(definition.languages);
+  return {
+    id: definition.id,
+    initialState: () => definition.initialState(),
+    analyze: (file) => languages.has(file.language) ? definition.analyze(file) : definition.initialState(),
+    merge: (left, right) => definition.merge(left, right),
+    report: (state) => definition.report(state)
+  };
+}
+
+// ../src/slices/internal/determinism.ts
+function compareText(left, right) {
+  return left < right ? -1 : left > right ? 1 : 0;
+}
+function sortedRecord(state) {
+  return Object.fromEntries(
+    Object.entries(state).sort(([left], [right]) => compareText(left, right))
+  );
+}
+function mergeDeterministicRecords(left, right) {
+  const merged = { ...left };
+  for (const [key, candidate] of Object.entries(right)) {
+    if (!Object.hasOwn(merged, key)) {
+      merged[key] = candidate;
+      continue;
+    }
+    const current = merged[key];
+    if (compareText(JSON.stringify(candidate), JSON.stringify(current)) < 0) merged[key] = candidate;
+  }
+  return sortedRecord(merged);
+}
+function compareSourceLocation(left, right) {
+  return compareText(left.path, right.path) || left.line - right.line || left.column - right.column || (left.endLine ?? 0) - (right.endLine ?? 0) || (left.endColumn ?? 0) - (right.endColumn ?? 0);
+}
+
+// ../src/slices/internal/define-record-slice.ts
+function defineRecordSlice(definition) {
+  return defineSlice({
+    ...definition,
+    initialState: () => ({}),
+    merge: (left, right) => mergeDeterministicRecords(left, right)
+  });
+}
+
+// ../src/slices/internal/languages.ts
+var JAVASCRIPT_LANGUAGES = Object.freeze([
+  "javascript",
+  "jsx",
+  "typescript",
+  "tsx"
+]);
+var JAVASCRIPT_AND_RUST_LANGUAGES = Object.freeze([...JAVASCRIPT_LANGUAGES, "rust"]);
+var RUST_LANGUAGES = Object.freeze([
+  "rust"
+]);
+
+// ../src/slices/internal/report.ts
+function findingAt(location, fact) {
+  return {
+    path: location.path,
+    line: location.line,
+    column: location.column,
+    fact
+  };
+}
+
+// ../src/slices/internal/ast.ts
+function sourceSite(node) {
+  const range = node.range();
+  return {
+    line: range.start.line + 1,
+    column: range.start.column + 1,
+    endLine: range.end.line + 1,
+    endColumn: range.end.column + 1
+  };
+}
+function nodesOfKinds(root, kinds) {
+  const matches = [];
+  const pending = [root];
+  while (pending.length > 0) {
+    const node = pending.pop();
+    if (!node) continue;
+    if (kinds.has(node.kind())) matches.push(node);
+    pending.push(...node.children());
+  }
+  return matches.sort(compareNodeLocation);
+}
+function nodesOfKind(root, kind) {
+  return nodesOfKinds(root, /* @__PURE__ */ new Set([kind]));
+}
+function compareNodeLocation(left, right) {
+  const leftRange = left.range();
+  const rightRange = right.range();
+  return leftRange.start.index - rightRange.start.index || leftRange.end.index - rightRange.end.index || compareText(left.kind(), right.kind());
+}
+
+// ../src/slices/shared/deep-nesting.ts
+var DEEP_NESTING_DEPTH_THRESHOLD = 5;
+var RUST_DEEP_NESTING_DEPTH_THRESHOLD = 6;
+var EVIDENCE_LIMIT = 10;
+var FUNCTION_KINDS = /* @__PURE__ */ new Set([
+  "function_declaration",
+  "generator_function_declaration",
+  "function_expression",
+  "generator_function",
+  "arrow_function",
+  "method_definition",
+  "function_item",
+  "closure_expression"
+]);
+var CONTROL_FLOW_KINDS = /* @__PURE__ */ new Set([
+  "if_statement",
+  "for_statement",
+  "for_in_statement",
+  "while_statement",
+  "do_statement",
+  "switch_statement",
+  "try_statement",
+  "if_expression",
+  "for_expression",
+  "while_expression",
+  "loop_expression",
+  "match_expression"
+]);
+var deepNestingSlice = defineRecordSlice({
+  languages: JAVASCRIPT_AND_RUST_LANGUAGES,
+  id: "complexity/deep-nesting",
+  analyze(file) {
+    const state = {};
+    const threshold = file.language === "rust" ? RUST_DEEP_NESTING_DEPTH_THRESHOLD : DEEP_NESTING_DEPTH_THRESHOLD;
+    for (const functionNode of nodesOfKinds(file.root, FUNCTION_KINDS)) {
+      const functionSite = sourceSite(functionNode);
+      const body = functionNode.field("body");
+      if (!body) continue;
+      visitFunctionBody(body, functionNode, 0, (node, depth) => {
+        if (depth < threshold) return;
+        const item = {
+          path: file.path,
+          ...sourceSite(node),
+          kind: node.kind(),
+          depth,
+          functionKind: functionNode.kind(),
+          functionLine: functionSite.line,
+          functionColumn: functionSite.column,
+          threshold
+        };
+        state[fingerprint(item)] = item;
+      });
+    }
+    return sortedRecord(state);
+  },
+  report(state) {
+    const sites = Object.values(state).sort(compareLocation);
+    if (sites.length === 0) return null;
+    const findings = sites.slice(0, EVIDENCE_LIMIT).map((item) => findingAt(item, `${item.kind} is at function-local control-flow depth ${item.depth}, ends at ${item.endLine}:${item.endColumn}, and is inside ${item.functionKind} at ${item.functionLine}:${item.functionColumn}.`));
+    return {
+      ruleId: "complexity/deep-nesting",
+      title: "Deep control-flow nesting",
+      summary: `${sites.length} control-flow site(s) exceed their language threshold (JavaScript/TypeScript: depth ${DEEP_NESTING_DEPTH_THRESHOLD} or greater; Rust: depth ${RUST_DEEP_NESTING_DEPTH_THRESHOLD} or greater); nested functions start their own depth and up to ${EVIDENCE_LIMIT} sites are shown.`,
+      findings,
+      remediation: "Use guard clauses or extract focused helpers so the control flow has fewer simultaneously nested conditions.",
+      quips: Object.freeze([
+        "The happy path left breadcrumbs and still has not made it back.",
+        "The indentation has entered geological strata.",
+        "This control flow comes with a descent map.",
+        "The exit is five decisions uphill.",
+        "These branches built a basement under the basement."
+      ])
+    };
+  }
+});
+function visitFunctionBody(node, functionNode, depth, visit2) {
+  if (node !== functionNode && FUNCTION_KINDS.has(node.kind())) return;
+  const isControlFlow = CONTROL_FLOW_KINDS.has(node.kind());
+  const nextDepth = isControlFlow ? depth + 1 : depth;
+  if (isControlFlow) visit2(node, nextDepth);
+  const alternative = node.kind() === "if_statement" || node.kind() === "if_expression" ? node.field("alternative") : null;
+  const alternativeIsElseIf = alternative ? isElseIfAlternative(alternative) : false;
+  for (const child of node.children()) {
+    const childDepth = alternativeIsElseIf && alternative && sameNode(child, alternative) ? depth : nextDepth;
+    visitFunctionBody(child, functionNode, childDepth, visit2);
+  }
+}
+function isElseIfAlternative(alternative) {
+  if (alternative.kind() === "if_statement" || alternative.kind() === "if_expression") return true;
+  return alternative.kind() === "else_clause" && alternative.children().some(
+    (child) => child.isNamed() && (child.kind() === "if_statement" || child.kind() === "if_expression")
+  );
+}
+function sameNode(left, right) {
+  const leftRange = left.range();
+  const rightRange = right.range();
+  return left.kind() === right.kind() && leftRange.start.index === rightRange.start.index && leftRange.end.index === rightRange.end.index;
+}
+function fingerprint(item) {
+  return [item.path, item.line, item.column, item.endLine, item.endColumn, item.kind, item.functionLine, item.functionColumn].join(":");
+}
+function compareLocation(left, right) {
+  return compareSourceLocation(left, right) || left.functionLine - right.functionLine || left.functionColumn - right.functionColumn;
+}
+
+// ../src/slices/shared/high-branching.ts
+var HIGH_BRANCHING_SITE_THRESHOLD = 12;
+var RUST_HIGH_BRANCHING_SITE_THRESHOLD = 12;
+var EVIDENCE_LIMIT2 = 10;
+var FUNCTION_KINDS2 = /* @__PURE__ */ new Set([
+  "function_declaration",
+  "generator_function_declaration",
+  "function_expression",
+  "generator_function",
+  "arrow_function",
+  "method_definition",
+  "function_item",
+  "closure_expression"
+]);
+var BRANCH_SITE_KINDS = /* @__PURE__ */ new Set([
+  "if_statement",
+  "for_statement",
+  "for_in_statement",
+  "while_statement",
+  "do_statement",
+  "switch_case",
+  "switch_default",
+  "catch_clause",
+  "ternary_expression",
+  "if_expression",
+  "for_expression",
+  "while_expression",
+  "loop_expression",
+  "match_arm"
+]);
+var highBranchingSlice = defineRecordSlice({
+  languages: JAVASCRIPT_AND_RUST_LANGUAGES,
+  id: "complexity/high-branching",
+  analyze(file) {
+    const state = {};
+    for (const functionNode of nodesOfKinds(file.root, FUNCTION_KINDS2)) {
+      const body = functionNode.field("body");
+      const branchSites = body ? countBranchSites(body, functionNode) : 0;
+      const threshold = file.language === "rust" ? RUST_HIGH_BRANCHING_SITE_THRESHOLD : HIGH_BRANCHING_SITE_THRESHOLD;
+      if (branchSites < threshold) continue;
+      const item = {
+        path: file.path,
+        ...sourceSite(functionNode),
+        kind: functionNode.kind(),
+        branchSites,
+        threshold
+      };
+      state[fingerprint2(item)] = item;
+    }
+    return sortedRecord(state);
+  },
+  report(state) {
+    const functions = Object.values(state).sort(compareLocation2);
+    if (functions.length === 0) return null;
+    const findings = functions.slice(0, EVIDENCE_LIMIT2).map((item) => findingAt(item, `${item.kind} contains ${item.branchSites} function-local syntactic branch sites and ends at ${item.endLine}:${item.endColumn}; nested functions are excluded.`));
+    return {
