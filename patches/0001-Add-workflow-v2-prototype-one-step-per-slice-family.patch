@@ -0,0 +1,46 @@
+// Appended after the bundled core by build.mjs. A workflow.ts may only import
+// from codemod:workflow, so the slices travel inside this one file.
+import { forEachFile, parse, shell, step } from "codemod:workflow";
+
+type Params = { out?: string };
+
+export default async function main({ params }: { params: Params }) {
+  // One step per family, run together: each family re-parses every file.
+  const scans = await Promise.all(
+    FAMILIES.map((family) =>
+      step(
+        `Analyze ${family}`,
+        forEachFile({ include: SOURCE_GLOBS, exclude: GENERATED_GLOBS }, (file) => {
+          const state = nonEmptyState(analyzeFile(file.path, parse(file).root(), family));
+          return state ? { path: file.path, state } : undefined;
+        }),
+      ),
+    ),
+  );
+
+  const sections = await step("Merge findings", () =>
+    reportSections(mergeStates(scans.flatMap((scan) => scan.outputs.map((output) => output.state)))),
+  );
+
+  // Random once, then recorded: a resumed run replays the same roasts.
+  const quips = await step("Pick roasts", () =>
+    Object.fromEntries(
+      sections.map((section) => [
+        section.ruleId,
+        section.quips[Math.floor(Math.random() * section.quips.length)],
+      ]),
+    ),
+  );
+
+  // Every family parses the same files, so one family's failures cover them all.
+  const report = [renderReport(sections, quips), renderWarnings(scans[0]?.failures ?? [])]
+    .filter(Boolean)
+    .join("\n\n");
+  const write = params.out ? '> "$ROAST_OUT"' : "";
+  await step(
+    "Print report",
+    shell(`printf '%s\\n' "$ROAST_REPORT" ${write}`, {
+      env: { ROAST_REPORT: report, ROAST_OUT: params.out ?? "" },
+    }),
+  );
+}
