--- /dev/null
+++ b/workflow/build.mjs
@@ -0,0 +1,27 @@
+// Bundles the roaster core with each workflow body: src/main.ts -> workflow.ts,
+// src/main-single.ts -> variants/single/workflow.ts.
+import { build } from "esbuild";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+
+const here = new URL(".", import.meta.url).pathname;
+const bundle = await build({
+  entryPoints: [`${here}src/core.ts`],
+  bundle: true,
+  format: "esm",
+  platform: "neutral",
+  write: false,
+});
+const core = bundle.outputFiles[0].text.replace(/^export \{[\s\S]*?\};\s*$/m, "");
+
+for (const [body, out] of [
+  ["src/main.ts", "workflow.ts"],
+  ["src/main-single.ts", "variants/single/workflow.ts"],
+]) {
+  const main = readFileSync(`${here}${body}`, "utf8");
+  const imports = main.match(/^import .*;$/m)[0];
+  mkdirSync(`${here}${out}`.replace(/[^/]+$/, ""), { recursive: true });
+  writeFileSync(
+    `${here}${out}`,
+    `// Generated by build.mjs from ${body}; do not edit.\n${imports}\n${core}\n${main.replace(imports, "")}`,
+  );
+}
