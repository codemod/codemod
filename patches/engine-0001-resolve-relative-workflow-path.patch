+#[test]
+fn a_workflow_loaded_by_a_relative_path_resolves_imports_from_its_own_directory() {
+    let h = Harness::new();
+    h.bundle_file("src/helper.ts", "export const answer = 42;\n");
+    std::fs::write(
+        h.bundle.path().join("workflow.ts"),
+        "import { answer } from \"./src/helper.ts\";\nexport default async function main() { return answer; }\n",
+    )
+    .unwrap();
+    let cwd = std::env::current_dir().unwrap();
+    let up: std::path::PathBuf = cwd.components().skip(1).map(|_| "..").collect();
+    let relative = up
+        .join(h.bundle.path().strip_prefix("/").unwrap())
+        .join("workflow.ts");
+
+    assert!(codemod_workflow::load_workflow(&relative).is_ok());
+}
